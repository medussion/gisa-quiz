{
  "name": "gisa-quiz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:reset": "tsx scripts/reset.ts",
    "questions:validate": "tsx scripts/questions-validate.ts",
    "questions:import": "tsx scripts/questions-import.ts",
    "questions:duplicates": "tsx scripts/questions-duplicates.ts",
    "questions:unverified": "tsx scripts/questions-unverified.ts",
    "collect:fetch": "tsx scripts/collect/fetch-newbt.ts",
    "collect:parse": "tsx scripts/collect/parse-newbt.ts",
    "collect:crosscheck": "tsx scripts/collect/cross-check.ts",
    "collect": "npm run collect:fetch && npm run collect:parse && npm run collect:crosscheck -- --write && npm run collect:parse && npm run questions:validate && npm run questions:import",
    "setup": "npm run db:migrate && npm run questions:import"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "drizzle-orm": "^0.44.2",
    "next": "^15.5.25",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "drizzle-kit": "^0.31.2",
    "eslint": "^9.29.0",
    "eslint-config-next": "^15.5.25",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
